+/*
+ * uart bridge: called by the core's br_c2b task with one chunk (<= ATT MTU - 3 bytes).
+ * "Ready" = a central is connected AND it enabled notifications on ae02; otherwise the
+ * core drops and counts the data. The data is copied into the stack's send buffer by
+ * ble_comm_att_send_data() [assumed: it is the same call the SDK's own UART path uses].
+ */
+int bridge_bt_send(const u8 *data, u16 len)
+{
+    u16 h = trans_con_handle;
+    int ret;
+
+    if (!h || !ble_gatt_server_characteristic_ccc_get(h, ATT_CHARACTERISTIC_ae02_01_CLIENT_CONFIGURATION_HANDLE)) {
+        return BR_TX_NOT_READY;
+    }
+    if (!ble_comm_att_check_send(h, len)) {
+        return BR_TX_BUSY;
+    }
+    ret = ble_comm_att_send_data(h, ATT_CHARACTERISTIC_ae02_01_VALUE_HANDLE, (u8 *)data, len, ATT_OP_AUTO_READ_CCC);
+    if (ret == GATT_OP_RET_SUCESS) {
+        return BR_TX_OK;
+    }
+    if (ret == GATT_BUFFER_FULL || ret == GATT_CMD_RET_BUSY) {
+        return BR_TX_BUSY;
+    }
+    if (ret == GATT_CMD_USE_CCC_FAIL || ret == GATT_CMD_STACK_NOT_RUN) {
+        return BR_TX_NOT_READY;
+    }
+    return BR_TX_FAIL;
+}
